# --- security -----------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ENVIRONMENT=development
DEBUG=true

# --- database -----------------------------------------------------------
# SQLite by default. For Postgres:
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/resume_reviewer
DATABASE_URL=sqlite+aiosqlite:///./resume_reviewer.db

# --- frontend origins (comma-separated) ---------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- OpenAI (optional; the rule engine works without it) ----------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- tokens -------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
